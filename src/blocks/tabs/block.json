{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "matter/tabs",
	"version": "1.0.0",
	"title": "Tabs",
	"category": "widgets",
	"icon": "index-card",
	"description": "Content split into tabs. Add tabs by hand, or show posts with a query.",
	"attributes": {
		"label": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"deepLink": {
			"type": "boolean",
			"default": false
		},
		"orientation": {
			"type": "string",
			"enum": [
				"horizontal",
				"vertical"
			],
			"default": "horizontal"
		},
		"dropdown": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"interactivity": true,
		"matter": {
			"scheme": true
		}
	},
	"textdomain": "matter",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
