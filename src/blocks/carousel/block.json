{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "matter/carousel",
	"version": "1.0.0",
	"title": "Carousel",
	"category": "widgets",
	"icon": "slides",
	"description": "Slides that scroll horizontally. Each block inside is a slide; or show posts or products with a query.",
	"keywords": [ "slider", "slideshow", "gallery" ],
	"attributes": {
		"label": {
			"type": "string",
			"default": "",
			"role": "content"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"interactivity": true,
		"matter": {
			"scheme": true
		}
	},
	"textdomain": "matter",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
