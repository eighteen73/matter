{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "matter/collapsible",
	"version": "1.0.0",
	"title": "Collapsible",
	"category": "widgets",
	"icon": "arrow-down-alt2",
	"description": "Content that is hidden until a link or button pointing to its #ID reveals it.",
	"keywords": [
		"toggle",
		"disclosure",
		"reveal",
		"show more"
	],
	"attributes": {
		"overlayId": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"interactivity": true,
		"matter": {
			"scheme": true
		}
	},
	"textdomain": "matter",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "matter/overlay",
	"render": "file:./render.php"
}
