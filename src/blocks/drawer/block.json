{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "matter/drawer",
	"version": "1.0.0",
	"title": "Drawer",
	"category": "widgets",
	"icon": "align-pull-right",
	"description": "Content that slides in from the edge of the screen. Open it with any link or button pointing to its #ID.",
	"keywords": [
		"offcanvas",
		"sidebar",
		"panel"
	],
	"attributes": {
		"overlayId": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"position": {
			"type": "string",
			"enum": [
				"end",
				"start"
			],
			"default": "end"
		},
		"openOnLoad": {
			"type": "boolean",
			"default": false
		},
		"openDelay": {
			"type": "number",
			"default": 0
		},
		"openOnScroll": {
			"type": "boolean",
			"default": false
		},
		"scrollThreshold": {
			"type": "number",
			"default": 50
		},
		"urlTriggers": {
			"type": "array",
			"default": []
		},
		"dismissDays": {
			"type": "number",
			"default": 0
		},
		"dismissible": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"interactivity": true,
		"matter": {
			"scheme": true,
			"section": false,
			"slots": {
				"trigger": {},
				"content": {
					"template": [
						[
							"core/heading",
							{
								"level": 2,
								"placeholder": "Heading"
							}
						],
						[
							"core/paragraph",
							{
								"placeholder": "Content…"
							}
						]
					]
				}
			}
		}
	},
	"textdomain": "matter",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "matter/overlay",
	"render": "file:./render.php",
	"usesContext": [
		"postId"
	]
}
