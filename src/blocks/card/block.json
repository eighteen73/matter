{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "matter/card",
	"version": "1.0.0",
	"title": "Card",
	"category": "theme",
	"description": "The theme's card for the current item in a loop. The design lives in the theme, so every loop and carousel shows the same card.",
	"keywords": [ "loop", "item", "post", "product" ],
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"inserter": false,
		"reusable": false,
		"lock": false,
		"renaming": false,
		"customCSS": false
	},
	"textdomain": "matter",
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
