{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "matter/accordion-item",
	"version": "1.0.0",
	"title": "Accordion item",
	"category": "widgets",
	"icon": "minus",
	"description": "A title and the content it reveals.",
	"parent": [ "matter/accordion", "core/post-template" ],
	"attributes": {
		"title": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"open": {
			"type": "boolean",
			"default": false
		}
	},
	"usesContext": [ "matter/headingLevel", "postId", "postType" ],
	"supports": {
		"html": false,
		"reusable": false
	},
	"textdomain": "matter",
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
