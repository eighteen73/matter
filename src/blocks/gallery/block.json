{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "matter/gallery",
	"version": "1.0.0",
	"title": "Gallery",
	"category": "media",
	"icon": "format-gallery",
	"description": "Images in a grid or carousel that open in a lightbox.",
	"keywords": [ "images", "photos", "lightbox" ],
	"attributes": {
		"lightbox": {
			"type": "boolean",
			"default": true
		},
		"label": {
			"type": "string",
			"default": "",
			"role": "content"
		}
	},
	"styles": [
		{ "name": "grid", "label": "Grid", "isDefault": true },
		{ "name": "carousel", "label": "Carousel" }
	],
	"supports": {
		"html": false,
		"anchor": true,
		"interactivity": true
	},
	"textdomain": "matter",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
