{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "matter/gallery",
	"version": "1.0.0",
	"title": "Gallery",
	"category": "media",
	"icon": "format-gallery",
	"description": "Images in a grid or carousel that open in a lightbox, cropped to one aspect ratio.",
	"keywords": [
		"images",
		"photos",
		"lightbox"
	],
	"attributes": {
		"layout": {
			"type": "string",
			"enum": [
				"grid",
				"carousel"
			],
			"default": "grid"
		},
		"limit": {
			"type": "number",
			"default": 0
		},
		"lightbox": {
			"type": "boolean",
			"default": true
		},
		"captions": {
			"type": "string",
			"enum": [
				"",
				"tooltip",
				"overlay",
				"hidden"
			],
			"default": ""
		},
		"label": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"columns": {
			"type": "number",
			"default": 0
		},
		"aspectRatio": {
			"type": "string",
			"default": ""
		},
		"allowResize": {
			"type": "boolean",
			"default": false
		}
	},
	"providesContext": {
		"allowResize": "allowResize"
	},
	"supports": {
		"html": false,
		"anchor": true,
		"interactivity": true
	},
	"textdomain": "matter",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
