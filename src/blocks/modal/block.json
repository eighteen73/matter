{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "matter/modal",
	"version": "1.0.0",
	"title": "Modal",
	"category": "widgets",
	"icon": "external",
	"description": "Content shown in a dialog over the page. Open it with any link or button pointing to its #ID.",
	"keywords": [
		"dialog",
		"popup",
		"lightbox"
	],
	"attributes": {
		"overlayId": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"openOnLoad": {
			"type": "boolean",
			"default": false
		},
		"openDelay": {
			"type": "number",
			"default": 0
		},
		"openOnScroll": {
			"type": "boolean",
			"default": false
		},
		"scrollThreshold": {
			"type": "number",
			"default": 50
		},
		"urlTriggers": {
			"type": "array",
			"default": []
		},
		"dismissDays": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"interactivity": true,
		"matter": {
			"scheme": true
		}
	},
	"textdomain": "matter",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "matter/overlay",
	"render": "file:./render.php"
}
