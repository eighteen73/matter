{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "matter/accordion",
	"version": "1.0.0",
	"title": "Accordion",
	"category": "widgets",
	"icon": "list-view",
	"description": "Expandable items of content. Add items by hand, or list posts with a query.",
	"keywords": [ "faq", "toggle", "expand", "collapse" ],
	"attributes": {
		"headingLevel": {
			"type": "number",
			"default": 3
		},
		"autoclose": {
			"type": "boolean",
			"default": false
		},
		"openFirst": {
			"type": "boolean",
			"default": false
		},
		"faqSchema": {
			"type": "boolean",
			"default": false
		}
	},
	"providesContext": {
		"matter/headingLevel": "headingLevel"
	},
	"supports": {
		"html": false,
		"anchor": true,
		"interactivity": true,
		"matter": {
			"scheme": true
		}
	},
	"textdomain": "matter",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
