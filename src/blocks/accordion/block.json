{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "matter/accordion",
	"version": "1.0.0",
	"title": "Accordion",
	"category": "widgets",
	"description": "Expandable items you write here. To list FAQs or other posts automatically, use Posts accordion.",
	"keywords": [
		"faq",
		"toggle",
		"expand",
		"collapse"
	],
	"attributes": {
		"matterId": {
			"type": "string"
		},
		"headingLevel": {
			"type": "number",
			"default": 3
		},
		"autoclose": {
			"type": "boolean",
			"default": false
		},
		"openFirst": {
			"type": "boolean",
			"default": false
		},
		"faqSchema": {
			"type": "boolean",
			"default": false
		}
	},
	"providesContext": {
		"matter/headingLevel": "headingLevel",
		"matter/autoclose": "autoclose",
		"matter/openFirst": "openFirst"
	},
	"example": {
		"attributes": {
			"openFirst": true
		},
		"innerBlocks": [
			{
				"name": "matter/accordion-item",
				"attributes": {
					"title": "What's included?"
				},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Everything you need to get started, delivered together."
						}
					}
				]
			},
			{
				"name": "matter/accordion-item",
				"attributes": {
					"title": "How long does it take?"
				},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Most orders arrive within a week."
						}
					}
				]
			},
			{
				"name": "matter/accordion-item",
				"attributes": {
					"title": "Can I change my order?"
				},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "Yes, until it's dispatched."
						}
					}
				]
			}
		]
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"interactivity": true,
		"matter": {
			"scheme": true
		}
	},
	"textdomain": "matter",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
