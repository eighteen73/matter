{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "matter/gravity-form",
	"version": "1.0.0",
	"title": "Gravity Form",
	"category": "widgets",
	"description": "Displays a Gravity Form",
	"keywords": [
		"form",
		"forms",
		"contact"
	],
	"attributes": {
		"formId": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"displayTitle": {
			"type": "boolean",
			"default": false
		},
		"displayDescription": {
			"type": "boolean",
			"default": false
		},
		"ajaxSubmission": {
			"type": "boolean",
			"default": true
		},
		"tabindex": {
			"type": "number",
			"default": 0
		},
		"fieldValues": {
			"type": "object",
			"default": null
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"renaming": false,
		"customCSS": false
	},
	"textdomain": "matter",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
